{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "packages"
  ],
  "compilerOptions": {
    "types": [
      "src/global.d.ts"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "."
    ],
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "$consts": [
        "src/consts"
      ],
      "$content/*": [
        "src/content/*"
      ],
      "$components": [
        "src/components"
      ],
      "$components/*": [
        "src/components/*"
      ],
      "$layouts/*": [
        "src/layouts/*"
      ],
      "$styles/*": [
        "src/styles/*"
      ]
    }
  }
}
