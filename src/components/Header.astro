---
import ThemeToggle from "virtual:tylant/components/ThemeToggle";
import { kSiteTitle } from "$consts";
const links = [["/", "首页"], ["/posts/", "文章"], ["/about/", "关于"]];
---
<a class="skip-link" href="#main-content">跳转到正文</a>
<header class="site-header">
  <nav aria-label="主导航">
    <a class="site-name" href="/">{kSiteTitle}</a>
    <div class="nav-links">
      {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>)}
    </div>
    <ThemeToggle />
  </nav>
</header>
