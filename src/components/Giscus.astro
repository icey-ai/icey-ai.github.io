---
interface Props { pathname: string; }
const { pathname } = Astro.props;
// Match giscus/client.ts's pathname mapping, including its removed leading slash.
const term = pathname.length < 2 ? 'index' : pathname.substring(1).replace(/\.\w+$/, '');
---
<section class="comments" aria-label="评论">
  <h2>评论</h2>
  <div class="giscus" data-comment-path={term}></div>
  <script>
    const container = document.querySelector<HTMLElement>('[data-comment-path]');
    if (container) {
      const theme = () => document.documentElement.classList.contains('dark') ? 'dark_tritanopia' : 'light';
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      const attrs = {
        'data-repo': 'icey-ai/icey-ai.github.io', 'data-repo-id': 'R_kgDOKC5Nfw',
        'data-category': 'Announcements', 'data-category-id': 'DIC_kwDOKC5Nf84CYU8Q',
        // Pin the old pathname so previews and aliases reuse the original discussion.
        'data-mapping': 'specific', 'data-term': container.dataset.commentPath!,
        'data-strict': '1', 'data-reactions-enabled': '1', 'data-emit-metadata': '0',
        'data-input-position': 'top', 'data-theme': theme(), 'data-lang': 'zh-CN', 'data-loading': 'lazy',
      };
      for (const [key, value] of Object.entries(attrs)) script.setAttribute(key, value);
      container.append(script);
      new MutationObserver(() => {
        container.querySelector('iframe')?.contentWindow?.postMessage({ giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app');
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    }
  </script>
</section>
