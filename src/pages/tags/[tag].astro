---
import Page from "$layouts/Page.astro";
import PostList from "$components/PostList.astro";
import { publishedPosts, type Post } from "../../lib/posts";
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return [...new Set(posts.flatMap(post => post.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
interface Props { tag: string; posts: Post[]; }
const { tag, posts } = Astro.props;
---
<Page title={`标签：${tag}`}><h1>{tag}</h1><PostList posts={posts} /></Page>
